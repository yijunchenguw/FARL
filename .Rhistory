Q = as.matrix(read_excel("Simulation_true.xlsx"))
# each item j has lambda_{j,1,1}, lambda_{j,1,2}, lambda{j,1,3}, and
# beta_{j,2,1}, beta_{j,2,2}, beta_{j,2,3}, beta_{j,2,4}, beta_{j,2,5}
lambda0=as.matrix(read_excel(paste0("trueitemparameters.xls"),
sheet = "Sheet1",col_names = FALSE,
.name_repair = "unique_quiet"))[,1]
lambda1=as.matrix(read_excel(paste0("trueitemparameters.xls"),
sheet = "Sheet2",col_names = FALSE,
.name_repair = "unique_quiet"))
lambda2=as.matrix(read_excel(paste0("trueitemparameters.xls"),
sheet = "Sheet3",col_names = FALSE,
.name_repair = "unique_quiet"))
resp <- as.matrix(read.csv('DFSM_EM_Observed_Responses_27_250_1.csv', header = TRUE)[, -1])
maxCat <- 4
nalpha <- 4 # Number of goal facets
nbeta <- 5 # Number of intermediate facets
# prior over profiles (estimated mixing proportion)
mixing_prop <- unlist(read.csv('trueprior_27_250_1.csv')[,1])
first_n <- 30
