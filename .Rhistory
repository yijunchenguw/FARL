install.packages("cowplot")
library(dplyr)
library(tidyr)
library(ggplot2)
library(cowplot)
library(stringr)
library(readr)
library(scales)
library(fmsb)
# ---------- Palettes ----------
pal_disc  <- c("Alphas present"="#2ca02c", "Betas present"="#D95F02", "Not present"="grey90")
pal_group <- c(Alpha = "#2ca02c", Beta = "#D95F02")
pct_lab   <- function(x) scales::percent(x, accuracy = 1)
# ---------- Read EAP & MAP (first student only) ----------
facet_names <- c(paste0("A", 1:nalpha), paste0("B", nalpha+1:nbeta))
n_facets <- length(facet_names)
#eap_raw <- read_csv("Cluster7_afterpanel_EAP.csv", col_names = FALSE, show_col_types = FALSE)
if (ncol(eap_raw) > n_facets) eap_raw <- eap_raw[, -1]
stopifnot(ncol(eap_raw) == n_facets)
colnames(eap_raw) <- facet_names
#map_raw <- read_csv("Cluster7_afterpanel_MAP.csv", col_names = FALSE, show_col_types = FALSE)
if (ncol(map_raw) > n_facets) map_raw <- map_raw[, -1]
stopifnot(ncol(map_raw) == n_facets)
colnames(map_raw) <- facet_names
# ---------- Tidy ----------
df_eap1 <- eap_first %>%
mutate(Student = student_label) %>%
pivot_longer(-Student, names_to = "Facet_name", values_to = "EAP") %>%
mutate(
Group      = if_else(str_detect(Facet_name, "^A"), "Alpha", "Beta"),
Facet_name = factor(Facet_name, levels = facet_names)
)
df_map1 <- map_first %>%
mutate(Student = student_label) %>%
pivot_longer(-Student, names_to = "Facet_name", values_to = "Status") %>%
mutate(
Group      = if_else(str_detect(Facet_name, "^A"), "Alpha", "Beta"),
fill_key   = case_when(
Status == 0 ~ "Not present",
Group == "Alpha" ~ "Alphas present",
TRUE ~ "Betas present"
),
Facet_name = factor(Facet_name, levels = facet_names),
fill_key   = factor(fill_key, levels = names(pal_disc))
)
# ---------- Legend for MAP statuses ----------
legend_plot <- ggplot(
data.frame(fill = factor(names(pal_disc), levels = names(pal_disc))),
aes(x = fill, y = 1, fill = fill)
) +
geom_col() +
scale_fill_manual(values = pal_disc,
breaks = c("Alphas present", "Betas present"),
name = NULL) +
guides(fill = guide_legend(nrow = 1)) +
theme_void() +
theme(legend.position = "top")
leg <- cowplot::get_legend(legend_plot)
# ---------- Separate plots ----------
# EAP plot (WITH y-axis)
p_eap <- ggplot(df_eap1, aes(Facet_name, EAP, fill = Group)) +
geom_col(width = 0.8, colour = "white") +
scale_fill_manual(values = pal_group, name = "Facet group") +
scale_y_continuous(
limits = c(0, 1.05),
breaks = c(0, .25, .5, .75, 1.0),
labels = pct_lab,
expand = expansion(mult = c(0, 0.02))
) +
labs(title = NULL, x = NULL, y = "Degree of confidence (%)") +
theme_minimal(base_size = 12) +
theme(
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.text.x  = element_blank(),      # hide x labels here; show them on MAP
axis.title.x = element_blank(),
axis.text.y  = element_text(color = "grey20"),
legend.position = "none",
plot.title = element_text(face = "bold", hjust = 0.5),
plot.margin = margin(5, 5, 2, 5)
)
# MAP plot (NO y-axis, x labels shown)
p_map <- ggplot(df_map1, aes(Facet_name, 1, fill = fill_key)) +
geom_col(width = 0.8, colour = "white") +
scale_fill_manual(values = pal_disc,
breaks = c("Alphas present", "Betas present"),   # hide "Not present" in legend
name   = NULL,
drop   = FALSE) +
coord_cartesian(ylim = c(0, 1)) +
labs(title = " ", x = NULL, y = NULL) +
theme_minimal(base_size = 12) +
theme(
panel.grid = element_blank(),
axis.text.y  = element_blank(),
axis.ticks.y = element_blank(),
axis.text.x  = element_text(angle = 45, hjust = 1),
legend.position = "none",
plot.title = element_text(face = "bold", hjust = 0.5),
plot.margin = margin(2, 5, 5, 5)
)
# ---------- Align vertically so bars line up ----------
aligned <- cowplot::align_plots(p_eap, p_map, align = "v", axis = "lr")
panel <- cowplot::plot_grid(aligned[[1]], aligned[[2]], ncol = 1, rel_heights = c(1, 0.45))
# ---------- Assemble ----------
title_grob <- cowplot::ggdraw() + cowplot::draw_label(paste0(student_label," Understanding by Facet"),
fontface = "bold", size = 16, hjust = 0.5)
final_one <- cowplot::plot_grid(title_grob, leg, panel, ncol = 1, rel_heights = c(0.10, 0.12, 1))
final_one
rm(list=ls())
gc()
