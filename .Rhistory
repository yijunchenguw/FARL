library(fmsb)
library(scales)
library(tibble)
library(png)
library(grid)
library(gridExtra)
# ========== 1) Data & helpers (your setup) ==========
facet_A  <- paste0("A", 1L:nalpha)
facet_B  <- paste0("B", (nalpha + 1L):(nalpha + nbeta))
facet_AB <- c(facet_A, facet_B)
k <- length(facet_AB)
vals_A  <- as.numeric(eap_raw[stu_idx, facet_A, drop = TRUE])
vals_B  <- as.numeric(eap_raw[stu_idx, facet_B, drop = TRUE])
val_all <- c(vals_A, vals_B)
dat_base <- as.data.frame(rbind(rep(1, k), rep(0, k), val_all))
colnames(dat_base) <- facet_AB
rownames(dat_base) <- c("max","min","vals")
theta <- pi/2 + 2*pi*(0:(k-1))/k
# draw_wedge <- function(idxs, col_fill, col_line, lwd = 3, show_pts = TRUE) {
#   r  <- val_all[idxs]
#   th <- theta[idxs]
#   x_poly <- c(0, r * cos(th), 0)
#   y_poly <- c(0, r * sin(th), 0)
#   polygon(x_poly, y_poly, col = alpha(col_fill, 0.35), border = NA)
#   lines(r * cos(th), r * sin(th), col = col_line, lwd = lwd)
#   if (show_pts) points(r * cos(th), r * sin(th), pch = 21, bg = "white", col = col_line)
# }
draw_single_wedge <- function(idx, col_line = "#2ca02c", lwd = 2, show_pts = FALSE) {
r  <- val_all[idx]
th <- theta[idx]
width <- 20 * pi / 180
th1 <- th - width
th2 <- th + width
th_seq <- seq(th1, th2, length.out = 80)
# polygon points
x_poly <- c(0, r*cos(th_seq), 0)
y_poly <- c(0, r*sin(th_seq), 0)
# fill
polygon(x_poly, y_poly,
col = alpha(col_line, 0.35),
border = NA)
# boundaries
segments(0, 0, r*cos(th1), r*sin(th1), col = col_line, lwd = lwd)
segments(0, 0, r*cos(th2), r*sin(th2), col = col_line, lwd = lwd)
# arc
lines(r*cos(th_seq), r*sin(th_seq), col = col_line, lwd = lwd)
# point
if (show_pts)
points(r*cos(th), r*sin(th), pch = 21, bg = "white", col = col_line, cex = 1.2)
}
draw_wedge <- function(idx, col_line = "#2ca02c", lwd = 2, show_pts = TRUE) {
for (i in idx) {
draw_single_wedge(i, col_line = col_line, lwd = lwd, show_pts = show_pts)
}
}
