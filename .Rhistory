x_poly <- c(0, r*cos(th_seq), 0)
y_poly <- c(0, r*sin(th_seq), 0)
# fill
polygon(x_poly, y_poly,
col = alpha(col_line, 0.35),
border = NA)
# boundaries
segments(0, 0, r*cos(th1), r*sin(th1), col = col_line, lwd = lwd)
segments(0, 0, r*cos(th2), r*sin(th2), col = col_line, lwd = lwd)
# arc
lines(r*cos(th_seq), r*sin(th_seq), col = col_line, lwd = lwd)
# point
if (show_pts)
points(r*cos(th), r*sin(th), pch = 21, bg = "white", col = col_line, cex = 1.2)
}
draw_wedge <- function(idx, col_line = "#2ca02c", lwd = 2, show_pts = TRUE) {
for (i in idx) {
draw_single_wedge(i, col_line = col_line, lwd = lwd, show_pts = show_pts)
}
}
col_alpha <- "#2ca02c"
col_beta  <- "#D95F02"
op <- par(mar = c(1, 2, 3, 2))
radarchart(
dat_base,
axistype = 0,               # no polygon grid
pcol = NA, pfcol = NA, plwd = 1,
cglcol = NA,                # remove background hex grid
caxislabels = NA,           # remove default labels
vlabels = facet_AB, vlcex = 1,
centerzero = TRUE
)
r_seq <- seq(0, 1, by = 0.2)
for (r in r_seq) {
symbols(0, 0, circles = r, inches = FALSE, add = TRUE,
fg = "grey80", lwd = 1)
}
# ----- Add radial lines (segment separators) -----
offset <- 20 * pi / 180
for (i in 1:k) {
segments(0, 0, cos(theta[i]+offset), sin(theta[i]+offset), col = "grey80")
}
draw_wedge(1L:nalpha,                   col_line = col_alpha)
draw_wedge((nalpha+1L):(nalpha+nbeta),  col_line = col_beta)
title(main = "Web Profile")
legend("topright",
legend = c("Alpha", "Beta"),
fill   = c(alpha(col_alpha, 0.35), alpha(col_beta, 0.35)),
border = NA, bty = "n")
par(op)
