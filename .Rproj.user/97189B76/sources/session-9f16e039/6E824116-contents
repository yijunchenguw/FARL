  stuItems$key <- rep(new_itemNames,each=n)

  # 定义测试信息
  testDat <- data.frame(
    test = "comp",  # 测试名称
    subtest = "main",  # 子测试名称
    location = 0,  # 平均分
    scale = 1  # 标准差
  )

  parTab <- item_params %>%
    mutate(ItemID = new_itemNames,
           test = "comp",
           subtest = rep("main",each=J),
           slope = a,
           difficulty = -b/a,
           guessing = c,
           D = 1)

  parTab <- parTab[c("ItemID","test","subtest","slope","difficulty","guessing","D")]

  re <- paste("pc", 1:ncol(hatf_tra), sep = "", collapse = " + ")
  # Create the formula string
