  }
  formula_string <- paste("comp ~ 0", main_factors, " +", paste("pc", 1:ncol(hatf_tra), sep = "", collapse = " + "))

  # Convert the string to a formula object
  formula <- as.formula(formula_string)

  # Use Dire::mml with the formula object
  mmlcomp <- Dire::mml(
    formula,
    stuItems = stuItems,
    stuDat = stuDat,
    idVar = "subject",
    dichotParamTab = parTab,
    testScale = testDat,
    calcCor = TRUE
  )
  library(EdSurvey)
  # generate plausible values
  datPVs <- drawPVs(mmlcomp, npv = 10L)$data

  id11 <- stuDat$subject[X[,main[1]] == 1 & X[,main[2]] == 1]
  result_11 <- (datPVs[as.numeric(datPVs$id) %in% id11,-1])# %>% select(paste0("_dire", c(1:10)))

  id10 <- stuDat$subject[X[,main[1]] == 1 & X[,main[2]]  == 0 ]
  result_10 <-  (datPVs[as.numeric(datPVs$id) %in% id10,-1])# %>% select(paste0("_dire", c(1:10)))

  id01 <- stuDat$subject[X[,main[1]] == 0 & X[,main[2]]  == 1 ]
  result_01 <- (datPVs[as.numeric(datPVs$id) %in% id01,-1])# %>% select(paste0("_dire", c(1:10)))

