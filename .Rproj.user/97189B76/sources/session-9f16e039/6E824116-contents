draw_PVs_GVEM <- function (N, resp, beta_hat, sigma, Z, a, b,c, main, step, theta, X_discrete) {
  EAP_estimates <- numeric(N)
  EAP_variance <- numeric(N)
  Q <- 30
  t_q <- seq(-4,4, length.out = Q)  # Quadrature grid

  # Function to compute likelihood for an examinee
  compute_likelihood <- function(response_vector, a, b, c, t_q) {
    likelihood <- sapply(t_q, function(t) {
      P <- c + (1-c)*(1 / (1 + exp(-a * (t - b))))  # Compute P(X_ij | theta)
      prod((P^response_vector) * ((1 - P)^(1 - response_vector)))  # Compute likelihood
    })
    return(likelihood)
  }
  #theta_pre <- (F %*% (beta) + (E) %*% veta) /norm_c
  for (i in 1:N) {
    ################

    prior_f2 <- dnorm(t_q, mean = Z[i,]%*%beta_hat, sd = sigma)
    likelihood2 <- compute_likelihood(resp[i, ], a, b,0, t_q)  # Compute likelihood at each t_q
    # Compute EAP as weighted mean of t_q
    EAP_estimates[i]  <- sum(t_q * likelihood2 * prior_f2)/sum( likelihood2*prior_f2 )
    EAP_variance[i]  <- sum((t_q-EAP_estimates[i])^2 * likelihood2*prior_f2 )/sum( likelihood2 *prior_f2)
    ################
  }
  # 计算真实 theta 的均值
  true_mean <- mean(theta)
  # 计算 EAP 估计的均值
  eap_mean2 <- mean(EAP_estimates)
  print(paste("Difference using estimate:", round(eap_mean2 - true_mean, 3)))
  theta_pv <- vector(mode = "numeric",length = n*step)
  for(i in 1:N){
    for(j in 1:step)
    {
      theta_pv[(i-1)*step + j] <- rnorm(n = 1, EAP_estimates[i], sqrt(EAP_variance[i]))
    }
  }

  # X.rep <- vector("list", length(main))
  # for(i in c(1:length(main))){
  #   X.rep[[i]] <- unlist(lapply(X[,main[i]], function(x) {rep(x,step)}))
  # }
  X.rep <- vector("list", length(main))
  for(i in c(1:length(main))){
    X.rep[[i]] <- unlist(lapply(X_discrete[,i], function(x) {rep(x,step)}))
  }
  n <- length(main)
  # First create all possible combinations (32 groups for 5 binary variables)
  combinations <- expand.grid(replicate(n, 0:1, simplify = FALSE))
  colnames(combinations) <- main[1:n]  # main contains your 5 binary variable names

  # Initialize a list to store all 32 result matrices
  result_list <- vector("list", nrow(combinations))

  for(i in 1:nrow(combinations)) {
    # Build the logical condition for this combination
    condition <-
      X.rep[[1]] == combinations[i,1] &
      X.rep[[2]] == combinations[i,2] &
      X.rep[[3]] == combinations[i,3]  &
      X.rep[[4]] == combinations[i,4] &
      X.rep[[5]] == combinations[i,5]

    # Get theta values for this subgroup
    subgroup_theta <- theta_pv[condition]

    # Calculate number of subjects in this subgroup
    n_subjects <- sum(condition)/step  # Adjust for repeated measures

    # Store as matrix (subjects × steps)
    result_list[[i]] <- matrix(subgroup_theta,
                               nrow = n_subjects,
                               ncol = step,
                               byrow = TRUE)

  }

  mean_vector <- c()
  mean_v_vector <- c()
  var_vector <- c()
  for (result in result_list) {
    mean_vector <- c(mean_vector, mean(colMeans(result)))
    var_vector <- c(var_vector, variance.sample(result))
    mean_v_vector <- c(mean_v_vector, variance.cal(result))
  }
  return(list(mean = mean_vector, var = var_vector, mean_v = mean_v_vector ))
}

