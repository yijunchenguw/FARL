    var_vector <- c(var_vector, variance.sample(result, step = 10))
    mean_v_vector <- c(mean_v_vector, variance.cal(result, step = 10))
  }
  return(list(mean = mean_vector, var = var_vector, mean_v = mean_v_vector ))
