draw_PVs_manual_old<- function (beta_hat, sigma, U, X_p ,X, a, d, main, step, theta) {
  # Define quadrature points (30 points from -4 to 4)
  # Compute EAP estimates for each examinee
  EAP_estimates2 <- numeric(n)
  EAP_variance2 <- numeric(n)
  Q <- 30
  t_q <- seq(-4 , 4, length.out = Q)  # Quadrature grid

  # Function to compute likelihood for an examinee
  compute_likelihood <- function(response_vector, a, b, t_q) {
    likelihood <- sapply(t_q, function(t) {
      P <- 1 / (1 + exp(-a * (t - b)))  # Compute P(X_ij | theta)
      prod((P^response_vector) * ((1 - P)^(1 - response_vector)))  # Compute likelihood
    })
    return(likelihood)
  }
  #theta_pre <- (F %*% (beta) + (E) %*% veta) /norm_c
  for (i in 1:n) {
    ################

    prior_f2 <- dnorm(t_q, mean = c(U[i,], X_p[i,])%*%beta_hat, sd = sigma)
    likelihood2 <- compute_likelihood(resp[i, ], a, -(d/a), t_q)  # Compute likelihood at each t_q
    # Compute EAP as weighted mean of t_q
    EAP_estimates2[i]  <- sum(t_q * likelihood2 * prior_f2)/sum( likelihood2*prior_f2 )
    EAP_variance2[i]  <- sum((t_q-EAP_estimates2[i])^2 * likelihood2*prior_f2 )/sum( likelihood2 *prior_f2)
    ################
  }
  theta[1:10]
  EAP_estimates2[1:10]
  # 计算真实 theta 的均值
  true_mean <- mean(theta)
  # 计算 EAP 估计的均值
  eap_mean2 <- mean(EAP_estimates2)
  print(paste("Difference using estimate:", round(eap_mean2 - true_mean, 3)))
  theta_pv2 <- vector(mode = "numeric",length = n*step)
  for(i in 1:n){
    for(j in 1:step)
    {
      theta_pv2[(i-1)*step + j] <- rnorm(n = 1, EAP_estimates2[i], sqrt(EAP_variance2[i]))
    }
  }
  X.1 <- unlist(lapply(X[,main[1]], function(x) {rep(x,step)}))
  X.2 <- unlist(lapply(X[,main[2]], function(x) {rep(x,step)}))
  result11 <- theta_pv2[X.1== 1 & X.2==1]
  result10 <- theta_pv2[X.1== 1 & X.2==0]
  result01 <- theta_pv2[X.1== 0 & X.2==1]
  result00 <- theta_pv2[X.1== 0 & X.2==0]
  result11_m <- matrix(result11, nrow = sum(X[,main[1]]== 1 & X[,main[2]]==1), ncol = step, byrow = TRUE)
  result10_m <- matrix(result10, nrow = sum(X[,main[1]]== 1 & X[,main[2]]==0), ncol = step, byrow = TRUE)
  result01_m <- matrix(result01, nrow = sum(X[,main[1]]== 0 & X[,main[2]]==1), ncol = step, byrow = TRUE)
  result00_m <- matrix(result00, nrow = sum(X[,main[1]]== 0 & X[,main[2]]==0), ncol = step, byrow = TRUE)
  result_m <- matrix(theta_pv2, nrow = n, ncol = step, byrow = TRUE)
  return(list(mean = mean(theta_pv2), mean11 = mean(result11 ), mean10 = mean(result10),
              mean01 = mean(result01 ), mean00 =  mean(result00)
              , var = variance.sample(result_m, step),
              var11 = variance.sample(result11_m, step), var10 = variance.sample(result10_m, step),
