resultDebias <- FARLR_debias(n, resp, a, d,0, K_hat, ncol(X), seq(0.06,0.06, length.out = 1), delta.criteria = 1e-3, iter.max = 200, n_sam = 5, window.size = 100, theta_est_irt.mean, theta_est_irt.se,Uupdate,hatU, Fan,bin)
