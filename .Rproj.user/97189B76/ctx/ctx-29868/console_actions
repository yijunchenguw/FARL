        "    coefficients  = beta_hat,",
        "+ ",
        "    sigma = sigma_temp,",
        "+ ",
        "    LogLik = results[[minBIC]][[3]],",
        "+ ",
        "    minBIC = minBIC,",
        "+ ",
        "    Convergence = ifelse(iter<iter.max,\"Converged\",\"Did not converge\")",
        "+ ",
        "  ))",
        "+ ",
        "}",
