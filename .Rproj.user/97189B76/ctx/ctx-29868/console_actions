        "+ ",
        "  residuals_2 <- theta_sample - fitted_values.em",
        "+ ",
        "  WSSR <- sum(w_ik*(residuals_2^2))#",
        "+ ",
        "  sigma_temp <- sqrt(WSSR/(nrow(Z.em)-p))",
        "+ ",
        "+ ",
        "  return(list(coef <- beta_hat, sigma <- sigma_temp,  minBIC))",
        "+ ",
        "  return(list(",
